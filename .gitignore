.venv/
**/__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Dualify benchmark / experiment run logs (JSON reports from dualify-run, repo scans, etc.)
results/*
!results/expert-review-gold-benchmark/
!results/expert-review-gold-benchmark/**

# Dataset pipeline run logs (regenerated artifacts; keep clean/ + reports in git)
benchmark/dataset/runs/**/raw/
benchmark/dataset/runs/**/rejects/
benchmark/dataset/runs/**/lineage.json

# Curated dataset stays tracked: benchmark/dataset/docs/, benchmark/dataset/runs/**/clean/

# Upstream dataset sources (fetch with scripts/fetch_dataset_sources.sh)
benchmark/dataset/sources/CrossHair/
benchmark/dataset/sources/python-by-contract-corpus/
benchmark/repos/

.mypy_cache/
.pytest_cache/
.ruff_cache/
.DS_Store

# Env files with secrets (never commit). Presets stay tracked: *.example
.env*
!.env.example
!.env.*.example

# Conference papers: private submodules (not on public main).
# Clone with: git submodule update --init --recursive
# Setup: ./scripts/setup_conference_submodules.sh
conferences/


# Local editor / agent config (never commit)
.cursor/

# Local clone scratch area
repos/

# Windows / WSL metadata
*:Zone.Identifier
*.Zone.Identifier